{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/aritro-saha",
      "destination": "/aritrosaha",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^games\\.aritro\\.cloud$"
        }
      ],
      "destination": "https://www.aritro.cloud/play",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?!www\\.)(?<subdomain>[^.]+)\\.aritro\\.cloud"
        }
      ],
      "destination": "https://www.aritro.cloud/404",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/md/(.*)",
      "destination": "/api/md?path=$1"
    },
    {
      "source": "/(.*)\\.md",
      "destination": "/api/md?path=$1.md"
    },
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*text/markdown.*)"
        }
      ],
      "destination": "/api/md?path=$1"
    },
    {
      "source": "/((?!assets/|api/|\\.well-known/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt|ai\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Link",
          "value": "<https://www.aritro.cloud/llms.txt>; rel=\"describedby\", <https://www.aritro.cloud/llms-full.txt>; rel=\"describedby\", <https://www.aritro.cloud/ai.txt>; rel=\"describedby\""
        }
      ]
    }
  ]
}
